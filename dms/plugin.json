{
  "id": "absPlayer",
  "name": "Audiobookshelf",
  "description": "Audiobookshelf client for DankBar: books and podcasts, resume and progress sync, chapters, covers, and a themed popout player.",
  "version": "0.1.0",
  "author": "Jason Carrasco",
  "icon": "headphones",
  "type": "composite",
  "capabilities": [
    "daemon",
    "dankbar-widget"
  ],
  "components": {
    "daemon": "./AbsDaemon.qml",
    "widget": "./AbsWidget.qml"
  },
  "requires_dms": ">=1.6.0",
  "dependencies": [
    "mpv",
    "python3",
    "secret-tool",
    "gnome-keyring"
  ],
  "permissions": [
    "process",
    "network"
  ]
}
